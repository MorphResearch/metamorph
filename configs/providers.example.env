# Copy the relevant values into your shell environment. Never commit real API keys.

# Select one: mock, openai, deepseek, minimax, claude, glm
METAMORPH_PROVIDER=deepseek
METAMORPH_MODEL=deepseek-v4-pro

# Optional overrides for a custom compatible gateway:
# METAMORPH_BASE_URL=https://api.deepseek.com
# METAMORPH_API_KEY_ENV=DEEPSEEK_API_KEY

# Provider credentials (set only the one you use):
# OPENAI_API_KEY=replace-me
# DEEPSEEK_API_KEY=replace-me
# MINIMAX_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# ZAI_API_KEY=replace-me
# SENSENOVA_API_KEY=replace-me
