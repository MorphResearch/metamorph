  },
  "utility": {
    "definition": "strict_success_binary - lambda_cost_usd * cost_usd",
    "lambda_cost_usd": [0.25, 1.0, 4.0],
    "selection_rule": "not used in validation; final profile is created only from final P1"
  },
  "seeds": [300],
  "statistical_limitations": {
    "single_seed": true,
    "note": "Four-arm engineering validation only; excluded from P1/P3/profile/effect statistics."
  },
  "conditions": [
    {"id": "G0", "dag_id": "G0"},
    {"id": "G2", "dag_id": "G2"}
  ],
  "statistical_plan": {
    "unit": "task x condition x seed",
    "primary_metric": "protocol_valid",
    "secondary_metrics": ["total_tokens", "input_tokens", "output_tokens", "latency_seconds", "tool_calls", "cost_usd"],
    "comparison_rule": "report all four arms; do not use this validation set for profile selection"
  },
  "status": "pre_freeze_validation"
