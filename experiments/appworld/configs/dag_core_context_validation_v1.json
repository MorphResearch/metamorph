  "budget": {
    "max_steps": 100,
    "max_errors": 10,
    "max_total_tokens": 150000,
    "max_tool_calls": 500,
    "max_latency_seconds": 600,
    "allow_write": true,
    "tool_policy": "appworld_constrained_code_batch_with_function_fallback_v1",
    "emergency_multiplier": 2.0,
    "downstream_reservations": {"check": 18000, "finalization": 4096}
  },
  "run_control": {"arm_timeout_seconds": 900},
  "pricing": {
    "input_usd_per_million_tokens": 1.32,
    "output_usd_per_million_tokens": 3.96,
