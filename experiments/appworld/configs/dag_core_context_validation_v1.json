{
  "schema_version": "dag-v1",
  "experiment_id": "appworld_dag_core_context_validation_v1",
  "experiment": "DAG_E1",
  "benchmark": "AppWorld",
  "stage": "pre_freeze_context_projection_validation",
  "task_set": "context_projection_validation_v1",
  "lessons": {"enabled": false, "store_snapshot": null},
  "model": {
    "provider": "from_environment",
    "model_name_env": "METAMORPH_MODEL",
    "api_base_env": "METAMORPH_BASE_URL",
    "frozen_model_id": "deepseek-v4-pro",
    "temperature": 0.0,
    "max_output_tokens_per_call": 2048,
    "request_timeout_seconds": 90,
    "prompt_version": "appworld_dag_context_projection_v1",
    "tool_schema_version": "appworld_constrained_code_batch_v1"
  },
  "context_projection": {
    "mode": "deterministic_phase_local_v1",
    "max_model_visible_tool_chars": 6000,
    "max_model_visible_evidence_chars": 12000,
    "max_model_visible_list_items": 8,
    "full_trace_policy": "persist_raw_environment_log_and_immutable_phase_trace",
    "finalization_context": "node_objective_plus_projected_evidence_plus_contract"
